{
  "name": "dovotori",
  "version": "1.1.9",
  "description": "React version of my portfolio website",
  "author": {
    "name": "Dorian Ratovo",
    "email": "dovotori@proton.me",
    "url": "https://dovotori.gitlab.io"
  },
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run start\" \"npm run storybook:dev\"",
    "start": "cross-env ANALYZE=true webpack serve --config webpack/dev.js",
    "images": "node scripts/convert-images.js",
    "build": "webpack --config webpack/prod.js",
    "build:analyze": "cross-env ANALYZE=true webpack --config webpack/prod.js",
    "build:all": "concurrently \"webpack --config webpack/prod.js\" \"npm run storybook:build\"",
    "clean": "node scripts/cleanBuild.js",
    "labo:start": "cross-env NAME=picto webpack serve --config webpack/labo.dev.js",
    "labo:build": "webpack --config webpack/labo.prod.js",
    "local:serve": "npx http-server build/ -p 8080 -b -g --cors",
    "lint": "biome check --write --enforce-assist=true --no-errors-on-unmatched && biome check --files-ignore-unknown=true",
    "favicon": "node scripts/favicons.js",
    "test": "jest --config=jest.config.js",
    "upgrade": "npx npm-check-updates -u",
    "changelog": "npx auto-changelog -p",
    "docker:build:dev": "docker build --no-cache --target client_dev --tag dovotori_client_dev:latest .",
    "docker:run:dev": "docker run --name dovotori_client_dev -p 8080:8080 -d --rm dovotori_client_dev:latest",
    "docker:build:prod": "docker build --no-cache --target client_prod --tag dovotori_client_prod:latest .",
    "docker:run:prod": "docker run --name dovotori_client_prod --rm dovotori_client_prod:latest",
    "deploy": "gh-pages -d build --remote origin",
    "release": "node scripts/release.js",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "storybook:build": "cross-env PUBLIC_URL=/public storybook build -o build/storybook",
    "typecheck": "tsc --noEmit",
    "knip": "npx knip"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "browserslist": "> 0.25%, not dead",
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@svgr/webpack": "^8.1.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "loader-css": "^0.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-intersection-observer": "^10.0.3",
    "react-router": "^7.15.1",
    "react-router-dom": "^7.15.1",
    "style-loader": "^4.0.0",
    "styled-components": "^6.4.1",
    "sw-cache-plugin": "^1.1.0",
    "terser-webpack-plugin": "^5.6.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@biomejs/biome": "2.4.15",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-webpack5": "^10.4.0",
    "@storybook/testing-library": "^0.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@webgpu/types": "^0.1.70",
    "babel-jest": "^30.4.1",
    "compression-webpack-plugin": "^12.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "csv-parser": "^3.2.1",
    "earcut": "^3.0.2",
    "favicons": "^7.2.0",
    "geojson-vt": "^4.0.3",
    "gh-cli": "^0.0.1",
    "gh-pages": "^6.3.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.5",
    "ol": "^10.9.0",
    "puppeteer": "^25.0.2",
    "semver": "^7.8.0",
    "sharp": "^0.34.5",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.3",
    "storybook": "^10.4.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-dev-server": "^5.2.4",
    "webrtc-adapter": "^9.0.5"
  },
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/dovotori/dovotori.gitlab.io.git"
  },
  "keywords": [
    "dovotori",
    "website",
    "portfolio",
    "dorian"
  ],
  "bugs": {
    "url": "https://gitlab.com/dovotori/dovotori.gitlab.io/issues",
    "email": "dovotori@proton.me"
  },
  "homepage": "https://dovotori.gitlab.io",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --enforce-assist=true --no-errors-on-unmatched",
      "sh -c 'biome check --files-ignore-unknown=true || true'"
    ],
    "*": [
      "sh -c 'biome check --no-errors-on-unmatched --files-ignore-unknown=true || true'"
    ]
  }
}